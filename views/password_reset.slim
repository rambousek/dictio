section.section role="region"
  .container class="info is-pushed"
    h1 = I18n.t("auth.password_reset_title")
    - if @password_reset_sent
      p role="status" = I18n.t("auth.password_reset_sent")
    - elsif @password_reset_success
      p role="status" = I18n.t("auth.password_reset_success")
    - elsif @password_reset_token
      p = I18n.t("auth.password_reset_new_password_hint")
      - if @password_reset_error
        p role="alert" = I18n.t("auth.password_reset_errors.#{@password_reset_error}", default: I18n.t("auth.password_reset_errors.invalid"))
      form action="/reset-password/#{Rack::Utils.escape_path(@password_reset_token)}" method="post"
        input type="hidden" name="csrf_token" value=csrf_token
        p
          label for="reset-password" = I18n.t("auth.new_password")
          input#reset-password type="password" name="password" autocomplete="new-password" minlength="10" maxlength="1024" required=true
        p
          label for="reset-password-confirmation" = I18n.t("auth.password_confirmation")
          input#reset-password-confirmation type="password" name="password_confirmation" autocomplete="new-password" minlength="10" maxlength="1024" required=true
        button.btn type="submit" = I18n.t("auth.password_reset_submit")
    - else
      p = I18n.t("auth.password_reset_instructions")
      form action="/password-reset" method="post"
        input type="hidden" name="csrf_token" value=csrf_token
        p
          label for="reset-email" = I18n.t("auth.email")
          input#reset-email type="email" name="email" autocomplete="email" required=true
        button.btn type="submit" = I18n.t("auth.password_reset_submit_request")
    p
      a href="/login" = I18n.t("auth.back_to_login")

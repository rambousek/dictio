section.section role="region"
  .container class="info is-pushed" style="max-width: 450px;"
    h1 = I18n.t("auth.title")
    - if @login_error
      p role="alert" = I18n.t("auth.invalid")
      p
        a href="/password-reset" = I18n.t("auth.forgot_password")
    form action="/login" method="post"
      input type="hidden" name="return_to" value=@login_return_to
      input type="hidden" name="csrf_token" value=csrf_token
      p
        label for="login" = I18n.t("auth.login")
        input id="login" type="text" name="login" autocomplete="username" required=true autofocus=true
      p
        label for="password" = I18n.t("auth.password")
        input id="password" type="password" name="password" autocomplete="current-password" required=true
      button.btn type="submit" = I18n.t("auth.submit")
    p
      a href="/register" = I18n.t("auth.register_link")
    

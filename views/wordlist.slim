- wordlist_base_path = @wordlist_admin ? "/admin/wordlists/#{@wordlist['_id']}" : "/wordlists/#{@wordlist['_id']}"
main role="main"
  - if @wordlist_admin
    section.section role="region" style="background-color: #1c2641"
      .container
        .row
          article.col.col--2.col--start role="article"
            h1 style="color: white" = I18n.t("menu.admin")
            h2 style="color: silver" = I18n.t("admin.wordlists.title")
  section.section role="region"
    .container
      h1.wordlist-title
        span = @wordlist['name']
      p
        a href=(@wordlist_admin ? "/admin/wordlists" : "/wordlists") = I18n.t(@wordlist_admin ? "wordlists.back_admin" : "wordlists.back")
      - if @wordlist_error
        p role="alert" = I18n.t("wordlists.errors.#{@wordlist_error}", default: I18n.t("wordlists.invalid"))
      - if @sharing_updated
        p role="status" = I18n.t("wordlists.sharing_updated")
      - if @ownership_transferred
        p role="status" = I18n.t("wordlists.ownership_transferred")
      section.info.wordlist-settings-card
        details.wordlist-settings-details
          summary = I18n.t("wordlists.settings")
          form.wordlist-settings-form action="#{wordlist_base_path}/update" method="post"
              input type="hidden" name="csrf_token" value=csrf_token
              div.wordlist-settings-grid
                div.wordlist-settings-field
                  label for="wordlist-name" = I18n.t("wordlists.name")
                  input#wordlist-name type="text" name="name" maxlength=CzjWordLists::MAX_NAME_LENGTH required=true value=@wordlist['name']
                div.wordlist-settings-field
                  label for="wordlist-dict" = I18n.t("wordlists.dictionary")
                  input#wordlist-dict type="text" value=I18n.t("dict.#{@wordlist['dict']}") disabled=true
                div.wordlist-settings-field
                  label for="wordlist-sort" = I18n.t("wordlists.sort")
                  select#wordlist-sort name="sort_mode"
                    - CzjWordLists::SORT_MODES.each do |mode|
                      option value=mode selected=(mode == @wordlist['sort_mode']) = I18n.t("wordlists.sort_modes.#{mode}")
                div.wordlist-settings-field
                  label for="wordlist-second-language" = I18n.t("wordlists.second_language")
                  select#wordlist-second-language name="second_language"
                    - %w[none all].each do |mode|
                      option value=mode selected=(mode == (@wordlist['second_language'] || CzjWordLists::SECOND_LANGUAGE_ALL)) = I18n.t("wordlists.second_language_modes.#{mode}")
                    - @dict_info.each do |code, _info|
                      option value=code selected=(code == @wordlist['second_language']) = I18n.t("dict.#{code}")
              div.wordlist-settings-public
                label
                  input type="checkbox" name="is_public" value="true" checked=@wordlist['is_public']
                  = I18n.t("wordlists.public_toggle")
              - if @wordlist['is_public']
                p.wordlist-public-link
                  | #{I18n.t("wordlists.share_link")}:
                  a href="https://www.dictio.info/wordlist/#{@wordlist['share_token']}" https://www.dictio.info/wordlist/#{@wordlist['share_token']}
              button.btn type="submit" = I18n.t("wordlists.save")
          - if @wordlist_owner
              section.wordlist-settings-section
                h3 = I18n.t("wordlists.sharing")
                form.wordlist-user-selection action="#{wordlist_base_path}/sharing" method="post" data-user-selection="multiple" data-no-results=I18n.t("wordlists.user_search_no_results") data-search-error=I18n.t("wordlists.user_search_error") data-remove-label=I18n.t("wordlists.remove_user")
                  input type="hidden" name="csrf_token" value=csrf_token
                  - Array(@wordlist['shared_with']).each do |login|
                    input type="hidden" name="shared_with[]" value=login
                  label for="wordlist-shared-user-search" = I18n.t("wordlists.shared_users")
                  input#wordlist-shared-user-search.wordlist-user-search type="search" autocomplete="off" data-user-search="true" placeholder=I18n.t("wordlists.user_search_placeholder")
                  ul.wordlist-user-search-results data-user-results="true" role="listbox"
                  div.wordlist-selected-users data-selected-users="true"
                  small = I18n.t("wordlists.sharing_help")
                  button.btn type="submit" = I18n.t("wordlists.save_sharing")
              section.wordlist-settings-section
                h3 = I18n.t("wordlists.transfer_ownership")
                form.wordlist-user-selection action="#{wordlist_base_path}/transfer" method="post" data-user-selection="single" data-no-results=I18n.t("wordlists.user_search_no_results") data-search-error=I18n.t("wordlists.user_search_error") data-remove-label=I18n.t("wordlists.remove_user") onsubmit="return confirm('#{I18n.t("wordlists.confirm_transfer")}')"
                  input type="hidden" name="csrf_token" value=csrf_token
                  input type="hidden" name="new_owner_login" data-selected-login="true"
                  input#wordlist-new-owner-search.wordlist-user-search type="search" autocomplete="off" data-user-search="true" placeholder=I18n.t("wordlists.user_search_placeholder")
                  ul.wordlist-user-search-results data-user-results="true" role="listbox"
                  div.wordlist-selected-users data-selected-users="true"
                  small = I18n.t("wordlists.transfer_help")
                  button.btn type="submit" = I18n.t("wordlists.transfer")
              form.wordlist-settings-delete action="#{wordlist_base_path}/delete" method="post" onsubmit="return confirm('#{I18n.t("wordlists.confirm_delete")}')"
                input type="hidden" name="csrf_token" value=csrf_token
                button.btn.btn--secondary type="submit" = I18n.t("wordlists.delete")
          - if @wordlist_admin
            p.wordlist-owner-info = I18n.t("wordlists.owner_label", name: @wordlist_owner_name)
          - unless @wordlist_owner
              p.wordlist-owner-info = I18n.t("wordlists.owner_info", name: @wordlist_owner_name)
        - if @wordlist['is_public']
          p.wordlist-public-link
              | #{I18n.t("wordlists.share_link")}:
              a href="https://www.dictio.info/wordlist/#{@wordlist['share_token']}" https://www.dictio.info/wordlist/#{@wordlist['share_token']}
      hr
      h2 = I18n.t("wordlists.entries")
      - if params['added'] || params['duplicate'] || params['missing'] || params['invalid']
        p role="status" = I18n.t("wordlists.batch_result", added: params['added'].to_i, duplicate: params['duplicate'].to_i, missing: params['missing'].to_i, invalid: params['invalid'].to_i)
      form action="#{wordlist_base_path}/entries" method="post"
        input type="hidden" name="csrf_token" value=csrf_token
        div.wordlist-add-entry-controls
          input#entry-id.wordlist-entry-id type="text" name="entry_id" placeholder=I18n.t("wordlists.entry_id") aria-label=I18n.t("wordlists.entry_id") required=true aria-describedby="entry-id-help"
          button.btn type="submit" = I18n.t("wordlists.add")
        small#entry-id-help = I18n.t("wordlists.entry_ids_help")
      - if @entries.empty?
        p = I18n.t("wordlists.no_entries")
      - else
        ol.wordlist-entries
          - @entries.each_with_index do |item, index|
            li.wordlist-entry-row
              div class="wordlist-entry-main #{'wordlist-entry-main--sign' if @dict_info[item['dict']]['type'] == 'sign'}"
                - if item['entry']
                  - label = item['entry'].dig('lemma', 'title').to_s
                  - label = item['entry'].dig('lemma', 'video_front').to_s if label.empty?
                  - label = item['id'] if label.empty?
                  - if @dict_info[item['dict']]['type'] == 'sign'
                    - video_front = item['entry'].dig('lemma', 'video_front').to_s
                    - if video_front.empty?
                      img class=item['dict'] src="/img/emptyvideo.jpg" width="177"
                    - else
                      video class=item['dict'] width="177" height="142" onmouseover="this.play()" onmouseout="this.pause()"
                        source type="video/mp4" src="https://files.dictio.info/video#{item['dict']}/#{video_front}"
                    a href=word_lists.entry_url(@wordlist, item) = item['id']
                  - else
                    a href=word_lists.entry_url(@wordlist, item) #{label} (#{item['id']})
                  == slim :wordlist_entry_translations, locals: {item: item}
                - else
                  | #{item['id']} — #{I18n.t("wordlists.missing_entry")}
              div.wordlist-entry-actions
                form.wordlist-entry-action--remove action="#{wordlist_base_path}/entries/#{item['id']}/remove" method="post"
                  input type="hidden" name="csrf_token" value=csrf_token
                  button.btn.btn--secondary type="submit" title=I18n.t("wordlists.remove") aria-label=I18n.t("wordlists.remove") X
                - if @wordlist['sort_mode'] == 'manual'
                  form.wordlist-entry-action--move action="#{wordlist_base_path}/entries/#{item['id']}/move/up" method="post"
                    input type="hidden" name="csrf_token" value=csrf_token
                    button.btn.btn--secondary type="submit" title=I18n.t("wordlists.move_up") aria-label=I18n.t("wordlists.move_up") disabled=(index == 0) ↑
                  form.wordlist-entry-action--move action="#{wordlist_base_path}/entries/#{item['id']}/move/down" method="post"
                    input type="hidden" name="csrf_token" value=csrf_token
                    button.btn.btn--secondary type="submit" title=I18n.t("wordlists.move_down") aria-label=I18n.t("wordlists.move_down") disabled=(index == @entries.length - 1) ↓

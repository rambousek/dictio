style type="text/css"
  | .report-filter-list { max-width: 100%; }
  | .report-filter-list > .sub { margin: 0 0 14px; padding: 0 0 10px; border-bottom: 1px solid rgba(255,255,255,.12); }
  | .report-filter-list > .sub > label, .report-filter-list > .sub > span > label { display: block; margin-bottom: 7px; font-weight: 600; color: #d8d8d8; }
  | .report-filter-row { display: flex; align-items: center; gap: 9px; min-height: 32px; margin: 3px 0 !important; padding: 3px 5px; border: 1px solid transparent; border-radius: 4px; transition: background-color .12s ease, border-color .12s ease; }
  | .report-filter-row.is-plus { background: rgba(46,139,87,.20); border-color: rgba(46,139,87,.55); }
  | .report-filter-row.is-minus { background: rgba(220,53,69,.20); border-color: rgba(220,53,69,.55); }
  | .report-filter-label { display: flex; align-items: center; gap: 8px; flex: 1 1 auto; min-width: 0; cursor: pointer; }
  | .report-filter-label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  | .report-filter-check { appearance: none; -webkit-appearance: none; width: 18px; height: 18px; min-width: 18px; margin: 0; border: 2px solid #777; border-radius: 4px; background: transparent; cursor: pointer; position: relative; }
  | .report-filter-check:checked { border-color: #35b86b; background: #35b86b; }
  | .report-filter-check:checked::after { content: ""; position: absolute; left: 4px; top: 1px; width: 5px; height: 9px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  | .report-filter-switch { display: flex; flex: 0 0 auto; border: 1px solid #555; border-radius: 5px; overflow: hidden; background: #202020; }
  | .report-filter-switch-btn { width: 25px; height: 24px; padding: 0; border: 0; border-right: 1px solid #555; background: transparent; color: #aaa; font-size: 14px; line-height: 24px; cursor: pointer; }
  | .report-filter-switch-btn:last-child { border-right: 0; }
  | .report-filter-switch-btn:hover { background: rgba(255,255,255,.08); color: #fff; }
  | .report-filter-switch-btn.active { background: #03c9a9; color: #000; font-weight: 700; }
  | .report-filter-switch-btn[data-mode="off"].active { background: #444; color: #ddd; }
  | .report-filter-submit { margin-top: 12px; width: 100%; }
  | .report-preset-button { display: inline-flex; align-items: center; gap: 5px; margin: 2px 3px 2px 0; padding: 4px 9px; border: 1px solid gray !important; border-radius: 4px; background: none !important; color: #fff !important; font-size: inherit; line-height: 1.3; font-weight: 600; text-decoration: none; cursor: pointer; box-shadow: 0 0 0 1px rgba(255,255,255,.08); transition: background-color .12s ease, border-color .12s ease, box-shadow .12s ease, transform .08s ease; }
  | .report-preset-button::before { content: "▶"; font-size: 9px; opacity: .85; }
  | .report-preset-button:hover { background: #2fa85f !important; border-color: #49c878 !important; color: #fff !important; box-shadow: 0 0 0 2px rgba(53,184,107,.18); text-decoration: none; }
  | .report-preset-button:active { transform: translateY(1px); }
  | .report-filter-section > label, .report-filter-section > span { cursor: pointer; }
  | .report-filter-section > label, .report-filter-section > span > label { user-select: none; }
  | .report-filter-section-title { display: flex; align-items: center; gap: 7px; cursor: pointer; user-select: none; }
  | .report-filter-arrow { display: inline-block; width: 10px; font-size: 18px; line-height: 1; font-weight: 400; transition: transform .15s ease; }
  | .report-filter-arrow.is-expanded { transform: rotate(90deg); }
    input[type='checkbox'] {display: none} 
    .col label { font-size: 0.85rem; }    
    .sub.report-filter-section { border: 1px solid; border-radius: 5px; border-color: dimgray;}
    .div sub {border: 1px solid; border-radius: 5px; border-color: dimgray;}

  | @media (max-width: 600px) { .report-filter-row { min-height: 34px; } .report-filter-switch-btn { width: 27px; height: 26px; line-height: 26px; } }

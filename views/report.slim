                  button.btn.btn-secondary.report-filter-submit type="submit" Filtrovat

                javascript:
                  /*
                   * Po načtení stránky určujeme stav přímo z URL.
                   * Nespoléháme se pouze na atribut checked, protože ten sám
                   * o sobě nenastaví vizuální stav přepínače ani zvýraznění řádku.
                   */
                  var currentFilterUrl = new URL(window.location.href);
                  var currentFilterParams = currentFilterUrl.searchParams;

                  document.querySelectorAll('#report-filter-form .report-filter-row').forEach(function(row) {
                    var check = row.querySelector('.report-filter-check');
                    var switchEl = row.querySelector('.report-filter-switch');
                    if (!check || !switchEl) return;

                    var param = check.dataset.param;
                    var value = check.dataset.value;
                    var modeParam = check.dataset.modeParam || param;
                    var inverted = switchEl.dataset.inverted === 'true';
                    var active = false;
                    var currentMode = currentFilterParams.get(modeParam);

                    /* def_skup[] může být v URL vícekrát. */
                    if (param === 'def_skup[]') {
                      active = currentFilterParams.getAll('def_skup[]').indexOf(value) !== -1;
                    } else if (value) {
                      active = currentFilterParams.get(param) === value;
                    } else {
                      active = currentFilterParams.has(param);
                    }

                    if (!active) {
                      setReportFilterSwitch(row, 'off');
                      return;
                    }

                    /*
                     * '+' = obsahuje, '-' = neobsahuje.
                     * U párových filtrů je význam parametru obrácený.
                     */
                    var contains = currentMode === 'ano';
                    if (inverted) contains = !contains;
                    setReportFilterSwitch(row, contains ? 'plus' : 'minus');
                  });

                  function setReportFilterSwitch(row, mode) {
                    var check = row.querySelector('.report-filter-check');
                    var switchEl = row.querySelector('.report-filter-switch');
                    if (!check || !switchEl) return;

                    switchEl.querySelectorAll('.report-filter-switch-btn').forEach(function(btn) {
                      btn.classList.toggle('active', btn.dataset.mode === mode);
                    });
                    check.checked = mode !== 'off';
                    row.classList.toggle('is-plus', mode === 'plus');
                    row.classList.toggle('is-minus', mode === 'minus');
                  }

                  document.querySelectorAll('#report-filter-form .report-filter-switch-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                      var row = btn.closest('.report-filter-row');
                      setReportFilterSwitch(row, btn.dataset.mode);
                    });
                  });

                  document.querySelectorAll('#report-filter-form .report-filter-check').forEach(function(check) {
                    check.addEventListener('change', function() {
                      var row = check.closest('.report-filter-row');
                      var switchEl = row.querySelector('.report-filter-switch');
                      var active = switchEl ? switchEl.querySelector('.report-filter-switch-btn.active') : null;
                      setReportFilterSwitch(row, check.checked ? ((active && active.dataset.mode !== 'off') ? active.dataset.mode : 'plus') : 'off');
                    });
                  });

                  function toggleReportFilterSection(id, header) {
                    var section = document.getElementById(id);
                    if (!section) return;

                    var isOpen = section.style.display === 'block';
                    section.style.display = isOpen ? 'none' : 'block';

                    var arrow = header.querySelector('.report-filter-arrow');
                    if (arrow) arrow.classList.toggle('is-expanded', !isOpen);
                  }

                  function applyReportFilters(event) {
                    event.preventDefault();

                    var form = event.target;
                    var url = new URL(window.location.href);

                    var filterParams = [
                      'typhesla', 'seltyphesla', 'skup', 'def_skup[]',
                      'schvcelni', 'schvbocni', 'celni', 'bocni', 'bez_sw', 'nes_sw',
                      'mkok', 'sldruh', 'slovni_druh',
                      'vyznamcszad', 'vyznamvid', 'vyznam', 'vyznamcs',
                      'usagecszad', 'usagevid', 'usage', 'usagecs',
                      'translationcs', 'translationczj', 'translationen', 'translationasl',
                      'translationis', 'translationsj', 'translationspj', 'translationde',
                      'translationogs', 'translationuk', 'translationuzm', 'synonym',
                      'pubtranscs', 'pubtransczj', 'pubtransen', 'pubtransasl', 'pubtransis',
                      'pubtranssj', 'pubtransspj', 'pubtransde', 'pubtransogs', 'pubtransuk',
                      'pubtransuzm', 'pubsynonym', 'koment', 'komentbox'
                    ];

                    filterParams.forEach(function(param) {
                      url.searchParams.delete(param);
                    });

                    var selected = form.querySelectorAll('.report-filter-check:checked');
                    var groupMode = null;
                    var groupModeMismatch = false;
                    var singlePairSelected = {};
                    var singlePairMismatch = false;
                    var singlePairParams = { typhesla: true, sldruh: true, koment: true };

                    selected.forEach(function(check) {
                      var modeParam = check.dataset.modeParam;
                      var row = check.closest('.report-filter-row');
                      var switchEl = row ? row.querySelector('.report-filter-switch') : null;
                      var activeSwitch = switchEl ? switchEl.querySelector('.report-filter-switch-btn.active') : null;
                      var uiMode = activeSwitch ? activeSwitch.dataset.mode : 'plus';
                      var mode = uiMode === 'minus' ? 'ne' : 'ano';

                      if (switchEl && switchEl.dataset.inverted === 'true') {
                        mode = mode === 'ano' ? 'ne' : 'ano';
                      }

                      if (modeParam === 'skup') {
                        if (groupMode === null) groupMode = mode;
                        if (groupMode !== mode) groupModeMismatch = true;
                      }

                      if (singlePairParams[modeParam]) {
                        if (singlePairSelected[modeParam]) singlePairMismatch = true;
                        singlePairSelected[modeParam] = true;
                      }

                      var param = check.dataset.param;
                      var value = check.dataset.value || mode;

                      if (param === 'def_skup[]') {
                        url.searchParams.append('def_skup[]', value);
                      } else {
                        url.searchParams.set(param, value);
                      }

                      if (modeParam && modeParam !== param) {
                        url.searchParams.set(modeParam, mode);
                      }
                    });

                    if (groupModeMismatch) {
                      alert('U skupin musí být pro všechny vybrané položky zvoleno stejné nastavení: obsahuje / neobsahuje.');
                      return;
                    }

                    if (singlePairMismatch) {
                      alert('U skupin typ hesla, slovní druh a komentáře lze vybrat pouze jednu položku.');
                      return;
                    }

                    if (groupMode === null) {
                      url.searchParams.delete('skup');
                    }

                    window.location.href = url.pathname + (url.search ? url.search : '');
                  }
              a.btn style="background-color: gray; margin-left: auto; margin-right: auto" href="/#{@dictcode}/csvreport?#{@params.map{|k,v| (k=='def_skup'?"def_skup[]=#{v[0]}":"#{k}=#{v}")}.join('&')}" CSV export
              a#json-export-btn.btn style="background-color: gray; margin-left: auto; margin-right: auto; cursor: pointer" data-query="#{@params.map{|k,v| (k=='def_skup'?"def_skup[]=#{v[0]}":"#{k}=#{v}")}.join('&')}" onclick="startJsonExport()" JSON export
              javascript:
                var exportPollTimer = null;
                function startJsonExport() {
                  var btn = document.getElementById('json-export-btn');
                  if (btn.dataset.running) return;
                  btn.dataset.running = '1';
                  var orig = btn.textContent;
                  btn.textContent = 'Připravuje se…';
                  var reset = function() { delete btn.dataset.running; btn.textContent = orig; };
                  var fail = function() { clearInterval(exportPollTimer); reset(); alert('Export selhal.'); };
                  fetch('/#{@dictcode}/export/start?' + btn.dataset.query)
                    .then(function(r) { if (!r.ok) throw 0; return r.json(); })
                    .then(function(job) {
                      var tries = 0;
                      exportPollTimer = setInterval(function() {
                        tries += 1;
                        if (tries > 600) { fail(); return; }
                        fetch('/#{@dictcode}/export/status/' + job.id)
                          .then(function(r) { if (!r.ok) throw 0; return r.json(); })
                          .then(function(st) {
                            if (st.status === 'done') {
                              clearInterval(exportPollTimer);
                              reset();
                              window.location = '/#{@dictcode}/export/download/' + job.id;
                            } else if (st.status !== 'running') { fail(); }
                          })
                          .catch(fail);
                      }, 3000);
                    })
                    .catch(fail);
                }


                    | #{I18n.t("admin.koment.styldesc")}
                  - if @params['komentbox'] == 'vyznam'
                    | #{I18n.t("admin.koment.vyznam")}
                  - if @params['komentbox'] == '_us'
                    | #{I18n.t("admin.koment._us")}
                  - if @params['komentbox'] == 'vazby'
                    | #{I18n.t("admin.koment.vazby")}
              - if @is_admin or @is_edit
                - if @params.count{|k,_| k =~ /sw/} > 0
                  th               
                th width="10%"
                  a.btn class="btn--secondary" style="width: 100%;" href="https://edit.dictio.info/editor#{@dictcode}/?id=" 
                    | + #{I18n.t("admin.newentry")}        
            == slim :reportresultlist
          - if @report['resultcount'].to_i > @report['entries'].size
            div
              a.btn.load_next_report onclick="this.classList.add('loading')" data-dict=@dictcode #{I18n.t("search.load_next")}
              a.btn.transparent.load_rest_report onclick="this.classList.add('loading')" data-dict=@dictcode #{I18n.t("search.load_rest")}
    

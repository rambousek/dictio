main role="main"
  section.section role="region" style="background-color: #1c2641"
    .container
      .row
        article.col.col--2.col--start role="article"
          h1 style="color: white" #{I18n.t("menu.admin")} 
          h2 style="color: silver" #{I18n.t("admin.users.title")}
  section.section 
    .container      
      form action="/users" method="get"
        div.admin-user-search
          label for="user-search" = I18n.t("admin.users.search_label")
          input#user-search type="search" name="search" value=@user_search autocomplete="off" aria-autocomplete="list" aria-controls="user-search-results"
          ul#user-search-results.wordlist-user-search-results.admin-user-search-results hidden=true aria-label=I18n.t("admin.users.search_label") data-no-results=I18n.t("wordlists.user_search_no_results") data-search-error=I18n.t("wordlists.user_search_error")
        button.btn type="submit" = I18n.t("admin.users.search_button")
      a.btn href="/users?all=1" = I18n.t("admin.users.show_all")
      - @users.each do |user|
        table.info.user-info
          form
            input type="hidden" name="login" value="#{user['login']}"
            tr
              td colspan="2" 
                label
                  | #{I18n.t("admin.users.login")}:
                  input type="text" name="" value = user['login'] style="background-color: transparent" disabled="disabled"  
              td colspan="2"
                label
                  | #{I18n.t("admin.users.pass")}:
                  input type="password" name="pass"                                                   
            tr
              td colspan="2" 
                label
                  | #{I18n.t("admin.users.name")}:
                  input type="text" name="name" value="#{user['name']}" 
              td colspan="2"
                 label
                  | #{I18n.t("admin.users.email")}:
                  input type="text" name="email" value="#{user['email']}" size="40"
            tr
              td colspan="4"
                label
                  | #{I18n.t("admin.users.organization")}:
                  input type="text" name="organization" value="#{user['organization']}"
            tr
              td colspan="2"
                label
                  input type="checkbox" name="admin" checked=("checked" if user['admin'])
                  | #{I18n.t("admin.users.admin")}                
            tr
              td
                strong #{I18n.t("admin.users.editorright")}:
                br
                select name="editor" multiple="multiple" size="5" style="font-size: 0.87rem"
                  - ['transkripce', 'preklad', 'komparator', 'formal', 'video', 'cjformal', 'cjlemma', 'czjlemma'].each do |item|
                    option value="#{item}" selected=("selected" if user['editor'] and user['editor'].include?(item)) #{I18n.t('admin.users.editor.'+item)}
              td
                strong #{I18n.t("admin.users.revizorright")}:
                br
                select name="revizor" multiple="multiple" size="5" style="font-size: 0.87rem"
                  - ['transkripce', 'lingvist', 'video', 'lemmaczj', 'cjlingvist', 'lemmacj', 'preklad'].each do |item|
                    option value="#{item}" selected=("selected" if user['revizor'] and user['revizor'].include?(item)) #{I18n.t('admin.users.revizor.'+item)}
              td
                strong #{I18n.t("admin.users.pracskup")}:
                br
                select name="skupina" multiple="multiple" size="5" style="font-size: 0.87rem"
                  - ['biologie', 'informatika', 'matematika', 'podnikani', 'upol', 'obecna', 'spec', 'mdd', 'test', 'all'].each do |item|
                    option value="#{item}" selected=("selected" if user['skupina'] and user['skupina'].include?(item)) #{I18n.t('admin.group.'+item)}
              td
                strong #{I18n.t("admin.users.langs")}:
                br
                select name="langs" multiple="multiple" size="5" style="font-size: 0.87rem"
                  - @dict_info.each do |code, info|
                    option value="#{code}" selected=("selected" if user['lang'] and user['lang'].include?(code)) #{I18n.t("dict."+code)}
            tr
              td
                label
                  | #{I18n.t("admin.users.autom")}:
              td  
                strong #{I18n.t("admin.users.autom_autor")}
                input type="text" name="autor" value="#{user['autor']}"
              td
                strong #{I18n.t("admin.users.autom_copy")}
                input type="text" name="copy" value="#{user['copy']}"
              td
                strong #{I18n.t("admin.users.autom_zdroj")}
                input type="text" name="zdroj" value="#{user['zdroj']}"
            tr
              td
                input.btn.save-user type="button" value="#{I18n.t("admin.users.save")}"
              td
              td
              td
                input.btn.delete-user type="button" style="background-color: darkred" value="#{I18n.t("admin.users.delete")}"
                
        br

      dialog#user-delete-wordlists-dialog.user-delete-dialog aria-labelledby="user-delete-wordlists-title"
        h2#user-delete-wordlists-title = I18n.t("admin.users.delete_wordlists_dialog_title")
        p#user-delete-wordlists-message role="alert"
        div.user-delete-dialog__actions
          button#user-delete-wordlists-cancel.btn.btn--secondary type="button" = I18n.t("admin.users.delete_cancel")
          button#user-delete-wordlists-keep.btn type="button" = I18n.t("admin.users.delete_keep_wordlists")
          button#user-delete-wordlists-delete.btn type="button" style="background-color: darkred" = I18n.t("admin.users.delete_and_remove_wordlists")

      - if @show_all_users || !@user_search.empty?
        - if @matching_users.empty?
          p = I18n.t("admin.users.search_no_results")
        - else
          p = I18n.t("admin.users.search_results")
          ul
            - @matching_users.each do |user|
              li
                - selection_params = {"user" => user['login']}
                - selection_params["all"] = "1" if @show_all_users
                - selection_params["search"] = @user_search unless @user_search.empty?
                a href=("/users?" + Rack::Utils.build_query(selection_params)) = [user['login'], user['name']].compact.reject(&:empty?).join(" — ")
                small.user-search-summary style="margin-left: 0.35em"
                  - editor_rights = Array(user['editor'])
                  - wordlist_count = @user_wordlist_counts.fetch(user['login'], 0)
                  - user_rights = []
                  - user_rights << I18n.t("admin.users.search_admin") if user['admin']
                  - user_rights << I18n.t("admin.users.search_editor") unless editor_rights.empty?
                  - user_rights << I18n.t("admin.users.search_editor_komparator") if editor_rights.include?('komparator')
                  - user_details = []
                  - user_details << "(#{user_rights.join(', ')})" unless user_rights.empty?
                  - user_details << "#{I18n.t('admin.users.search_wordlists')}: #{wordlist_count}" if wordlist_count.positive?
                  = user_details.join(" ")
  
      button.btn#show-new-user type="button" = I18n.t("admin.users.add_user")
      table.info.user-info.new-user style="display: none"
        form
          tr
            td colspan="2" 
              label
                | #{I18n.t("admin.users.login")}:
                input type="text" name="login" size="40"
            td colspan="2"
              label
                | #{I18n.t("admin.users.pass")}:
                input type="password" name="pass"                               
          tr
            td colspan="2" 
              label
                | #{I18n.t("admin.users.name")}:
                input type="text" name="name" 
            td colspan="2"
              label
                | #{I18n.t("admin.users.email")}:
                input type="text" name="email" size="40"
          tr
            td colspan="4"
              label
                | #{I18n.t("admin.users.organization")}:
                input type="text" name="organization"
          tr                
            td colspan="2"
              label
                input type="checkbox" name="admin" 
                | #{I18n.t("admin.users.admin")}
          tr
            td
              strong #{I18n.t("admin.users.editorright")}:
              br
              select name="editor" multiple="multiple" size="5" style="font-size: 0.87rem"
                - ['transkripce', 'preklad', 'komparator', 'formal', 'video', 'cjformal', 'cjlemma', 'czjlemma'].each do |item|
                  option value="#{item}" #{I18n.t('admin.users.editor.'+item)}
            td
              strong #{I18n.t("admin.users.revizorright")}:
              br
              select name="revizor" multiple="multiple" size="5" style="font-size: 0.87rem"
                - ['transkripce', 'lingvist', 'video', 'lemmaczj', 'cjlingvist', 'lemmacj', 'preklad'].each do |item|
                  option value="#{item}" #{I18n.t('admin.users.revizor.'+item)}
            td
              strong #{I18n.t("admin.users.pracskup")}:
              br
              select name="skupina" multiple="multiple" size="5" style="font-size: 0.87rem"
                - ['biologie', 'informatika', 'matematika', 'podnikani', 'upol', 'obecna', 'spec', 'mdd', 'test', 'all'].each do |item|
                  option value="#{item}" #{I18n.t('admin.group.'+item)}
            td
              strong #{I18n.t("admin.users.langs")}:
              br
              select name="langs" multiple="multiple" size="5" style="font-size: 0.87rem"
                - @dict_info.each do |code, info|
                  option value="#{code}" #{I18n.t("dict."+code)}
          tr
            td
              label
                | #{I18n.t("admin.users.autom")}:
            td
              strong #{I18n.t("admin.users.autom_autor")}
              input type="text" name="autor"
            td
              strong #{I18n.t("admin.users.autom_copy")}
              input type="text" name="copy"
            td
              strong #{I18n.t("admin.users.autom_zdroj")}
              input type="text" name="zdroj"
          tr
            td
              input.btn.save-user type="button" value="#{I18n.t("admin.users.save")}"
            td
            td
            td
              

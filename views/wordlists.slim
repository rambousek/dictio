main role="main"
  section.section role="region"
    .container
      h1 = I18n.t("wordlists.title")
      - if @wordlist_error == 'invalid'
        p role="alert" = I18n.t("wordlists.invalid")
      - if @wordlists.empty?
        p = I18n.t("wordlists.empty")
      - else
        ul.wordlist-list
          - @wordlists.each do |wordlist|
            li.info.wordlist-list-card
              details.wordlist-list-details
                summary
                  a href="/wordlists/#{wordlist['_id']}" = wordlist['name']
                  span.wordlist-list-meta
                    | #{I18n.t("dict.#{wordlist['dict']}")}
                    - if wordlist['owner_login'] != @user_info['login']
                      |  · #{I18n.t("wordlists.shared_with_you")}
                    - if wordlist['is_public']
                      |  · #{I18n.t("wordlists.public")}
                    |  · #{I18n.t("wordlists.entries")}: #{Array(wordlist['entries']).length}
                p
                  a.btn href="/wordlists/#{wordlist['_id']}" = I18n.t("wordlists.show")
              - if wordlist['is_public']
                p.wordlist-public-link
                  | #{I18n.t("wordlists.share_link")}:
                  a href="https://www.dictio.info/wordlist/#{wordlist['share_token']}" https://www.dictio.info/wordlist/#{wordlist['share_token']}
      - unless @wordlist_error == 'invalid' || @show_new_wordlist_form
        button.btn#show-new-wordlist type="button" = I18n.t("wordlists.create")
      form#new-wordlist-form action="/wordlists" method="post" style=("display: none" unless @wordlist_error == 'invalid' || @show_new_wordlist_form)
        input type="hidden" name="csrf_token" value=csrf_token
        p
          label for="wordlist-name" = I18n.t("wordlists.name")
          input#wordlist-name type="text" name="name" maxlength=CzjWordLists::MAX_NAME_LENGTH required=true
        p
          label for="wordlist-dict" = I18n.t("wordlists.dictionary")
          select#wordlist-dict name="dict" required=true
            - @dict_info.each do |code, _info|
              option value=code selected=(code == @default_dict) = I18n.t("dict.#{code}")
        button.btn type="submit" = I18n.t("wordlists.create")

main role="main"
  section.section role="region" style="background-color: #1c2641"
    .container
      .row
        article.col.col--2.col--start role="article"
          h1 style="color: white" #{I18n.t("menu.admin")} 
          h2 style="color: silver" #{I18n.t("admin.wordlists.title")}
  section.section 
    .container
      - if @wordlists.empty?
        p = I18n.t("admin.wordlists.empty")
      - else
        table.table.wordlist-admin-table
          thead
            tr
              th = I18n.t("wordlists.name")
              th = I18n.t("wordlists.owner")
              th = I18n.t("wordlists.dictionary")
              th = I18n.t("wordlists.entry_count")
              th = I18n.t("wordlists.visibility")
          tbody
            - @wordlists.each do |wordlist|
              - owner_login = wordlist['owner_login'].to_s
              - owner_name = @wordlist_owners[owner_login].to_s.strip
              - owner_name = I18n.t("wordlists.no_owner") if owner_login.empty?
              - owner_name = owner_login if owner_name.empty?
              - owner_display = owner_login.empty? ? owner_name : "#{owner_name} (#{owner_login})"
              tr
                td
                  a href="/admin/wordlists/#{wordlist['_id']}" = wordlist['name']
                td = owner_display
                td = I18n.t("dict.#{wordlist['dict']}")
                td = Array(wordlist['entries']).length
                td = I18n.t(wordlist['is_public'] ? "wordlists.public" : "wordlists.private")
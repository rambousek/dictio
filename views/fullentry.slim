main id="mobilespacetop" role="main"
  == slim :searchbox
  section.detail role="region"
    article.container role="article"
      - if @is_edit or @is_admin
        - if @dict_info[@show_dictcode]['type'] == 'write'
          == slim :fullentrywritedetail_edit
        - else
          == slim :fullentrysigndetail_edit
      - else
        - if @dict_info[@show_dictcode]['type'] == 'write'
          == slim :fullentrywritedetail
        - else
          == slim :fullentrysigndetail
  - if @is_edit or @is_admin
    - entry_wordlists = CzjWordLists.new.list_for(@user_info['login'], @show_dictcode)
    section.container.wordlist-entry-tools role="region"
      - if @wordlist_added
        p role="status" = I18n.t("wordlists.entry_added")
      - if @wordlist_error
        p role="alert" = I18n.t("wordlists.errors.#{@wordlist_error}", default: I18n.t("wordlists.invalid"))
      div.wordlist-entry-tools-layout
        - unless entry_wordlists.empty?
          form.wordlist-add-entry-form action="/wordlists/add-entry" method="post"
            input type="hidden" name="csrf_token" value=csrf_token
            input type="hidden" name="dict" value=@show_dictcode
            input type="hidden" name="entry_id" value=@entry['id']
            div.wordlist-add-entry-field
              label for="wordlist-select" = I18n.t("wordlists.add_to")
              select#wordlist-select name="wordlist_id"
                - entry_wordlists.each do |wordlist|
                  option value=wordlist['_id'] = wordlist['name']
            button.btn type="submit" = I18n.t("wordlists.add")
        nav.wordlist-entry-tool-links aria-label=I18n.t("wordlists.title")
          a.btn.btn--secondary href="/wordlists?create=true" = I18n.t("wordlists.create")
          a.btn.btn--secondary href="/wordlists" = I18n.t("menu.wordlists")

#search-title-meta style="display: none"
  == slim :title

- if @add_cite and @cite_attr
  div#citeInfo *@cite_attr data-cite-text=@cite_text

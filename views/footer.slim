<!-- patička -->
footer.footer role="contentinfo"
  .modal id="modal" style="display: none" data-page-title=I18n.t("cite.page_title") data-part-title=I18n.t("cite.part_title") data-hint=I18n.t("cite.part_hint") data-cancel=I18n.t("cite.cancel")
    .modal-content
      h3 id="modalTitle"
      p id="modalText"

      .modal-buttons
        button#copyButton class="btn" style="margin-right: 10px" type="button" onclick="kopirovatText()" data-copy=I18n.t("cite.copy") data-copied=I18n.t("cite.copied") = I18n.t("cite.copy")
        button class="btn" type="button" onclick="zavriModal()" = I18n.t("cite.close")

  .container
    .footer__wrapper
      p.footer__copy
        span DICTIO v #{$app_version}#{$app_commit ? " (#{$app_commit})" : ''}
        |  &copy; 2007-#{Date.today.year} Masaryk University / All rights reserved
      nav.nav.nav--footer role="navigation"
        ul
          li
            a href="#" onclick="citaceGen(); return false;" #{I18n.t("menu.cite")}
          li.quote-part-link
            a href="#" onclick="toggleQuoteMode(); return false;" = I18n.t("cite.part_button")
          li
            a href="/help" #{I18n.t("menu.help")}
          li
            a href="/contact" #{I18n.t("menu.contact")}

  - if @cite_attr
    div#citeInfo *@cite_attr data-cite-text=@cite_text

<!-- /patička -->


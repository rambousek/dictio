main role="main"
  section.section role="region" style="background-color: #1c2641"
    .container
      h1 style="color: white" = I18n.t("admin.tasks.title")
  section.section
    .container
      - if params["saved"] == "true"
        p role="status" = I18n.t("admin.tasks.saved")
      - if params["count_updated"] == "true"
        p role="status" = I18n.t("admin.tasks.count_updated")
      p
        strong = I18n.t("admin.tasks.report")
        | :
        a href=@task["report_url"] target="_blank" rel="noopener" = @task["title"].to_s.strip.empty? ? @task["report_url"] : @task["title"]
      p
        strong = I18n.t("admin.tasks.entry_count")
        | : #{@task["entry_count"] || "-"}
      form action="/tasks/#{@task["_id"]}/refresh-count" method="post"
        input type="hidden" name="csrf_token" value=csrf_token
        button.btn.btn--secondary type="submit" = I18n.t("admin.tasks.refresh_count")
      form action="/tasks/#{@task["_id"]}" method="post"
        input type="hidden" name="csrf_token" value=csrf_token
        label for="task-title" = I18n.t("admin.tasks.name")
        input#task-title type="text" name="title" value=@task["title"] maxlength="200"
        label for="task-organization" = I18n.t("admin.users.organization")
        input#task-organization type="text" name="organization" list="task-organization-options" autocomplete="organization" value=@task["organization"]
        datalist#task-organization-options
          - Array(@organizations).each do |organization|
            option value=organization
        label for="task-assignee-search" = I18n.t("admin.tasks.assignee")
        div.wordlist-user-selection data-user-selection="single" data-selection-input-name="assigned_login" data-include-current="true" data-no-results=I18n.t("wordlists.user_search_no_results") data-search-error=I18n.t("wordlists.user_search_error") data-remove-label=I18n.t("wordlists.remove_user")
          input type="hidden" name="assigned_login" data-selected-login="true" data-selected-name=(@assigned_user && @assigned_user["name"]) value=@task["assigned_login"]
          input#task-assignee-search.wordlist-user-search type="search" autocomplete="off" data-user-search="true" placeholder=I18n.t("wordlists.user_search_placeholder")
          ul.wordlist-user-search-results data-user-results="true" role="listbox"
          div.wordlist-selected-users data-selected-users="true"
        button.btn type="submit" = I18n.t("admin.tasks.save")
